{
  "name": "keeping-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --open --host 0.0.0.0",
    "build": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "deploy": "npm run build && aws s3 sync ./dist/keeping-angular s3://REDACTED_S3_BUCKET --acl public-read --delete --profile REDACTED_AWS_PROFILE && aws cloudfront create-invalidation --distribution-id REDACTED_CF_DISTRIBUTION_ID --paths \"/*\" --profile REDACTED_AWS_PROFILE",
    "i18n:extract": "ngx-translate-extract --input ./src/app --output ./src/assets/i18n/ko.json ./src/assets/i18n/en.json --clean --sort --format namespaced-json"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^12.2.8",
    "@angular/common": "^12.2.8",
    "@angular/compiler": "^12.2.8",
    "@angular/core": "^12.2.8",
    "@angular/fire": "^6.1.5",
    "@angular/forms": "^12.2.8",
    "@angular/platform-browser": "^12.2.8",
    "@angular/platform-browser-dynamic": "^12.2.8",
    "@angular/router": "^12.2.8",
    "@ngx-translate/core": "^13.0.0",
    "@ngx-translate/http-loader": "^6.0.0",
    "dom-autoscroller": "^2.3.4",
    "firebase": "^8.10.0",
    "moment-timezone": "^0.5.33",
    "ng-inline-svg": "^13.1.2",
    "ng2-dragula": "^2.1.1",
    "ngx-image-cropper": "^5.0.1",
    "rxjs": "~6.6.0",
    "swiper": "^8.0.7",
    "tslib": "^2.3.1",
    "uuid": "^8.3.1",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.1202.8",
    "@angular-devkit/build-angular": "^12.2.8",
    "@angular/cli": "^12.2.8",
    "@angular/compiler-cli": "^12.2.8",
    "@biesbjerg/ngx-translate-extract": "^7.0.4",
    "@types/jasmine": "~3.8.0",
    "@types/node": "^12.20.27",
    "eslint": "^7.32.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "firebase-tools": "^9.19.0",
    "fuzzy": "^0.1.3",
    "inquirer": "^6.2.2",
    "inquirer-autocomplete-prompt": "^1.0.1",
    "jasmine-core": "~3.8.0",
    "jsonc-parser": "^3.0.0",
    "karma": "~6.3.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.0.3",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "~1.7.0",
    "open": "^7.0.3",
    "prettier": "2.5.1",
    "typescript": "~4.3.5"
  }
}
